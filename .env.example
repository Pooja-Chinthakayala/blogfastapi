# For easy local setup, SQLite is used by default in app/database.py.
# For PostgreSQL, uncomment and update DATABASE_URL:
# DATABASE_URL=postgresql+psycopg://blog_user:change_me@localhost:5432/blog_db
SECRET_KEY=replace-this-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=uploads
